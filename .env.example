# Copy this file to .env and fill in real values before running the app.
# `python app.py --init-db` will create the SQLite DB and seed defaults.

# --- Flask ---------------------------------------------------------------
FLASK_ENV=development          # development | production | testing
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-random-64-char-hex-string

# --- Selenium --------------------------------------------------------------
DEFAULT_BROWSER=chrome         # chrome | edge | firefox
HEADLESS=true
IMPLICIT_WAIT=10
EXECUTION_TIMEOUT=120

# --- Smart Retry Engine ------------------------------------------------------
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2.0
RETRY_BACKOFF_MULTIPLIER=1.5

# --- Flaky Detection -----------------------------------------------------------
FLAKY_WINDOW_SIZE=10
FLAKY_THRESHOLD_PCT=20.0

# --- AI Failure Analysis (Ollama) --------------------------------------------
AI_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
AI_REQUEST_TIMEOUT=60

# --- Sessions ------------------------------------------------------------------
SESSION_LIFETIME_DAYS=7
REMEMBER_ME_DAYS=30

# --- Branding --------------------------------------------------------------------
COMPANY_NAME=Smart QA Labs
REPORT_LOGO_TEXT=SmartRetry
